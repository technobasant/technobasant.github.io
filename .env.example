# Local secrets. Never commit this file.
# Cloudflare. The live hostname is DNS-only (grey cloud) → GitHub Pages, so
# WAF/Bot Fight Mode do not see traffic today. To change bot/WAF settings the
# token needs Zone.Bot Management Write, Zone.WAF Write, and Zone Settings Write
# in addition to Zone DNS. The env key is the one this repo actually reads.
CLOUDFARE_API_TOKEN=
# Bing Webmaster Tools API (SubmitFeed / SubmitUrl). IndexNow uses the public
# <key>.txt at the repo root instead — do not put that key here.
BING_WEBMASTER_API_KEY=
# Web3Forms access keys are public (they ship in the HTML on GitHub Pages).
# The live key lives in _data/forms.yml, not here.
